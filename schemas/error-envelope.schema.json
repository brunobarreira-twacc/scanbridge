{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "status": {
      "type": "string",
      "const": "error"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "usage_error",
            "invalid_configuration",
            "partial_input_refused",
            "invalid_report",
            "incompatible_reports"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "status",
    "error"
  ],
  "additionalProperties": false
}
