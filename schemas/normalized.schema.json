{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "content_trust": {
      "type": "string",
      "const": "untrusted_producer_content"
    },
    "producer": {
      "type": "string",
      "enum": [
        "semgrep",
        "zap"
      ]
    },
    "producer_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "git"
            },
            "relative_path": {
              "type": "string"
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "content_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "relative_path",
            "revision",
            "dirty",
            "content_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "directory"
            },
            "relative_path": {
              "type": "string"
            },
            "content_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "relative_path",
            "content_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "http_origin"
            },
            "origin": {
              "type": "string"
            },
            "asserted_revision": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "origin"
          ],
          "additionalProperties": false
        }
      ]
    },
    "completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unverified",
        "failed"
      ]
    },
    "authoritative": {
      "type": "boolean"
    },
    "non_authoritative_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "partial_scan",
          "registry_rules",
          "auto_rules",
          "fingerprint_degraded",
          "unmapped_severity",
          "offline_report"
        ]
      }
    },
    "fingerprint_version": {
      "type": "string"
    },
    "severity_mapping_version": {
      "type": "string"
    },
    "redaction_policy_version": {
      "type": "string"
    },
    "rules_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_sha256_before_redaction": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_sha256_after_redaction": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "redaction_summary": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^v[0-9]+:[0-9a-f]{64}$"
          },
          "fingerprint_quality": {
            "type": "string",
            "enum": [
              "exact",
              "degraded"
            ]
          },
          "producer_fingerprint": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "producer_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "original_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "text",
              "truncated",
              "original_length"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "original_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "text",
              "truncated",
              "original_length"
            ],
            "additionalProperties": false
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ]
          },
          "severity_original": {
            "type": "string"
          },
          "severity_complete": {
            "type": "boolean"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "original_length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "text",
                  "truncated",
                  "original_length"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "const": "open"
          },
          "redactions_applied": {
            "type": "boolean"
          },
          "occurrence_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "low",
                    "medium",
                    "high",
                    "critical",
                    "unknown"
                  ]
                },
                "severity_original": {
                  "type": "string"
                },
                "source_location": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "start_col": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "end_col": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "path",
                    "start_line",
                    "start_col",
                    "end_line",
                    "end_col"
                  ],
                  "additionalProperties": false
                },
                "runtime_location": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "method": {
                      "type": "string"
                    },
                    "param": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "method",
                    "param"
                  ],
                  "additionalProperties": false
                },
                "evidence": {
                  "type": "object",
                  "properties": {
                    "snippet": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string"
                            },
                            "truncated": {
                              "type": "boolean"
                            },
                            "original_length": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "text",
                            "truncated",
                            "original_length"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "attack": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string"
                            },
                            "truncated": {
                              "type": "boolean"
                            },
                            "original_length": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "text",
                            "truncated",
                            "original_length"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidence": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string"
                            },
                            "truncated": {
                              "type": "boolean"
                            },
                            "original_length": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "text",
                            "truncated",
                            "original_length"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "message_id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "severity",
                "severity_original",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "fingerprint",
          "fingerprint_quality",
          "rule_id",
          "producer_reference",
          "title",
          "severity",
          "severity_original",
          "severity_complete",
          "confidence",
          "status",
          "occurrence_count",
          "occurrences"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "content_trust",
    "producer",
    "producer_version",
    "target",
    "completeness",
    "authoritative",
    "non_authoritative_reasons",
    "fingerprint_version",
    "severity_mapping_version",
    "redaction_policy_version",
    "rules_digest",
    "configuration_digest",
    "raw_sha256_before_redaction",
    "raw_sha256_after_redaction",
    "redaction_summary",
    "findings"
  ],
  "additionalProperties": false
}
